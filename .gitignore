# PeopleFlow portfolio: publish source code, never employee data or credentials
build/
cmake-build-*/
.vscode/
.idea/
*.exe
*.o
*.obj
*.dll
*.so
*.dylib
*.pdb
*.log
peopleflow_web

# Runtime records, including migrated legacy text records and SQLite
# Keep only an empty placeholder file in data/.
data/*
!data/.gitkeep
*.db
*.sqlite
*.sqlite3
*.db-shm
*.db-wal
*.db-journal

# Secrets, private keys, environment configuration
.env
.env.*
*.pem
*.key
*.p12
*.pfx
secrets/
